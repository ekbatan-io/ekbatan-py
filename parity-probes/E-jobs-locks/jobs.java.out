PROBE validate.no_jobs: refused
PROBE validate.no_connection: refused
PROBE validate.null_job: refused
PROBE validate.null_in_jobs: refused
PROBE validate.blank_name: refused
PROBE validate.duplicate_names: refused
PROBE validate.null_schedule: refused
PROBE validate.zero_poll: refused
PROBE validate.negative_poll: refused
PROBE validate.zero_heartbeat: refused
PROBE validate.negative_shutdown_wait: refused
PROBE validate.zero_shutdown_wait: accepted
PROBE config.zero_polling: refused
PROBE config.zero_heartbeat: refused
PROBE config.negative_shutdown: refused
PROBE config.zero_shutdown: accepted
PROBE config.one_microsecond_polling: accepted
PROBE config.defaults_all_unset: true
PROBE j2.ran_at_start: 1
PROBE j2.row: j2-fixed|recurring|t|f|t|0|t|t|3|null
PROBE j2.next_run_in_minutes: 60
PROBE j2.restart.rows: 1
PROBE j2.restart.ran_again: false
PROBE j3.start: accepted
PROBE j3.rows: 0
PROBE j4.runs_at_least_4: true
PROBE j5.runs_at_least_2: true
PROBE j5.row: t|t|t|f
PROBE j6.start: refused
PROBE j6.type: IllegalStateException
PROBE j6.message_names_job: true
PROBE j7.start: accepted
PROBE j7.ghost_row: f|null|1
PROBE j8a.stop_elapsed_s: 1.5
PROBE j8a.job_done_when_stop_returned: true
PROBE j8a.row: f|t
PROBE j8b.stop_elapsed_s: 1.0
PROBE j8b.job_interrupted: true
PROBE j8b.job_done_when_stop_returned: false
PROBE j8b.job_done_later: false
PROBE j8b.row_after: f|t
PROBE j9.max_concurrent_of_3: 3
PROBE j10.picked_row_has_heartbeat: true
PROBE j10.heartbeat_moved_with_1s_interval: true
PROBE j11.heartbeat_unchanged_at_7s: true
PROBE j11.heartbeat_changed_by_13s: true
PROBE j11.run_starts_s: [10]
PROBE-DONE jobs
