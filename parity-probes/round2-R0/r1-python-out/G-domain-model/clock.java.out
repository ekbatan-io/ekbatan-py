PROBE system.maxFractionDigits: 6
PROBE system.subMicroNonZero: False
PROBE system.nearWallClock: True
PROBE system.zoneUtc: True
PROBE virtual.default.realTime: True
PROBE virtual.default.advance: ERR IllegalStateException: Cannot advance: clock is not paused
PROBE virtual.pauseAt.read: 2025-01-01T00:00:00.123456Z
PROBE virtual.pauseAt.twoReadsEqual: True
PROBE virtual.advance1500ms: 2025-01-01T00:00:01.623456Z
PROBE virtual.advance1us: 2025-01-01T00:00:01.623457Z
PROBE virtual.advanceNegative: OK 2024-12-31T23:59:51.623457Z
PROBE virtual.pauseAt.offsetInput: 2025-01-01T00:00:00Z
PROBE virtual.resumeFrom.nearAnchor: True
PROBE virtual.resumeFrom.advance: ERR IllegalStateException: Cannot advance: clock is not paused
PROBE virtual.pause.frozen: True
PROBE virtual.resume.realTime: True
PROBE virtual.constructedAtInstant.read: 2025-01-01T00:00:00.123456Z
PROBE virtual.constructedAtInstant.advance: ERR IllegalStateException: Cannot advance: clock is not paused
PROBE virtual.nanosInstant: 2025-01-01T00:00:00.123456789Z
PROBE toStorage.plus2: n/a (Instant has no zone)
