---
// /reference/ - the API and convention reference. Dense, exhaustive, lookup-oriented.
// Voice: assume the reader already knows what they want and wants the exact signature,
// property or path.
//
// This is Java's `reference/index.astro`, structurally: the same groups, in the same order,
// with the same card component and the same hand-written one-line blurbs. Two group names
// differ because the things under them do - there is no DI container here to integrate with -
// and two of Java's entries have no counterpart at all (annotations, native image).
//
// The groups[] registry below is the single source of truth for what is linked from here.
// Hand-written, as Java's is: these pages are the website's own. The repository's `docs/` tree
// is written for somebody reading the repository, and the two are free to differ.
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionCard from "../../components/SectionCard.astro";

const linkTo = (p: string) => `${import.meta.env.BASE_URL}${p.replace(/^\//, "")}`;

const groups = [
    {
        title: "Core primitives",
        entries: [
            { href: "/reference/action/", title: "Action", blurb: "The two phases, the perform() signature, the plan, and retries." },
            { href: "/reference/action-plan/", title: "ActionPlan", blurb: "Where perform() stages its changes: add(), update(), changes()." },
            { href: "/reference/action-executor/", title: "ActionExecutor", blurb: "Building one, what atomic means here, retries, and a custom event persister." },
            { href: "/reference/model/", title: "Model[ID, S]", blurb: "The immutable domain object that emits events: id, version, copy().with_event()." },
            { href: "/reference/entity/", title: "Entity[ID]", blurb: "Saved and versioned like a model, but emits no events." },
            { href: "/reference/model-event/", title: "ModelEvent", blurb: "The event a model emits: how to write one, and how it becomes an outbox row." },
        ],
    },
    {
        title: "Persistence",
        entries: [
            { href: "/reference/repository/", title: "Repository", blurb: "The reads and writes you get, the row mapping you write, and shard routing." },
            { href: "/reference/transaction-manager/", title: "TransactionManager", blurb: "Transactions outside an action: tm.transaction(), why not to nest it, isolation." },
            { href: "/reference/sharding/", title: "Sharding", blurb: "ShardedId, EmbeddedBitsShardingStrategy, and the group and member of a shard." },
            { href: "/reference/keyed-locks/", title: "Keyed locks", blurb: "A lock named by a string, on PostgreSQL, MySQL, MariaDB or Redis, and how a lease behaves." },
            { href: "/reference/multi-database/", title: "Multi-database", blurb: "The databases supported, the column-type cheatsheet, and the UTC rule." },
            { href: "/reference/migrations/", title: "Migrations", blurb: "Plain SQL files run by yoyo, with a lock, checks and a history added on top." },
            { href: "/reference/config-files/", title: "Config files", blurb: "The layout read from a YAML, TOML, JSON or INI file." },
            { href: "/reference/schemagen/", title: "schemagen", blurb: "Table definitions generated from a migrated database." },
        ],
    },
    {
        title: "Tables",
        entries: [
            { href: "/reference/tables/", title: "Framework tables", blurb: "Which framework tables you need, where they live, and how they get into your database." },
            { href: "/reference/tables/events/", title: "events", blurb: "The outbox: event rows written in the same transaction as each action." },
            { href: "/reference/tables/event-notifications/", title: "event_notifications", blurb: "Optional. One delivery row per event and handler: states, retries, handler names." },
            { href: "/reference/tables/scheduled-tasks/", title: "scheduled_tasks", blurb: "Optional. db-scheduler's table, for distributed jobs and in-process handlers." },
        ],
    },
    {
        title: "Wiring",
        entries: [
            { href: "/reference/wiring/", title: "Wiring a service", blurb: "Databases, repositories, actions, handlers and jobs, in one function." },
            { href: "/reference/wiring-fastapi/", title: "FastAPI", blurb: "The lifespan, the dependency, and the two common mistakes." },
        ],
    },
    {
        title: "Runtime",
        entries: [
            { href: "/reference/runtime/concurrency/", title: "Concurrency", blurb: "Threads, processes, asyncio, gevent and the GIL, and the one way to misuse the sync API." },
            { href: "/learn/sync-or-async/", title: "Sync or async?", blurb: "Two APIs, one framework: how to pick, what is the same, what differs, what runs on threads." },
            { href: "/reference/runtime/async/", title: "Native asyncio", blurb: "ekbatan.aio: the async drivers, the pool as the limit, locks, handlers, and what stays sync." },
            { href: "/reference/runtime/observability/", title: "Observability", blurb: "OpenTelemetry spans and metrics, and the logger names." },
            { href: "/reference/jobs/distributed-jobs/", title: "Distributed jobs", blurb: "DistributedJob, on db-scheduler: background work that runs on exactly one instance." },
            { href: "/reference/events/local-event-handler/", title: "Local event handler", blurb: "Handling events inside your own service: the fan-out and dispatch jobs." },
            { href: "/reference/events/streaming/", title: "Streaming (Debezium)", blurb: "The outbox to Kafka through Debezium: the Avro and Protobuf transforms, topics, and reading each format." },
        ],
    },
    {
        title: "Dialects",
        entries: [
            { href: "/reference/dialects/postgresql/", title: "PostgreSQL", blurb: "Native UUID, JSONB, partial indexes, SKIP LOCKED and RETURNING." },
            { href: "/reference/dialects/mysql/", title: "MySQL", blurb: "No UUID type, no partial indexes, and lock waits rounded to whole seconds." },
            { href: "/reference/dialects/mariadb/", title: "MariaDB", blurb: "Close enough to MySQL to share a driver, and four ways it is not." },
            { href: "/reference/dialects/sqlite/", title: "SQLite", blurb: "No server needed: good for tests and tools, and why it is not for production." },
        ],
    },
    {
        title: "Other languages",
        entries: [
            { href: "/reference/beside-java/", title: "Running beside a Java service", blurb: "Working with a service built on Ekbatan for Java through events on a broker and a Redis lock." },
        ],
    },
] as const;
---

<BaseLayout
    title="Reference"
    description="API and conventions reference. Class signatures, method semantics, dialect specifics, configuration keys."
    activeSection="reference"
>
    <section class="border-b-2 border-ink">
        <div class="container-px max-w-7xl mx-auto py-20 md:py-28">
            <div class="inline-flex items-center gap-3 brutalist-border bg-ink text-paper font-mono text-[11px] uppercase tracking-widest px-3 py-1.5">
                <span class="text-yellow">&#167;</span><span>Reference</span>
            </div>
            <h1 class="font-display font-bold text-4xl md:text-6xl tracking-tight max-w-4xl text-balance mt-6 leading-[0.95]">
                Every class.{' '}
                <span class="bg-yellow px-2">Every config.</span>
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed">
                For looking things up. Each page covers one class or one part of the framework:
                what it does, its methods and settings, and what differs between databases. If
                you already know what you are looking for, start here.
            </p>

            {
                groups.map((group) => (
                    <div class="mt-14">
                        <h2 class="font-display text-3xl font-bold tracking-tight border-b-2 border-ink pb-2">
                            {group.title}
                        </h2>
                        <div class="mt-6 grid md:grid-cols-2 lg:grid-cols-3 gap-5">
                            {group.entries.map((entry) => (
                                <SectionCard
                                    href={linkTo(entry.href)}
                                    title={entry.title}
                                    blurb={entry.blurb}
                                    status="ready"
                                    size="compact"
                                />
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>
    </section>
</BaseLayout>
