# --- Python ------------------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/

# --- tool caches -------------------------------------------------------------------------------
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- editors and OS ----------------------------------------------------------------------------
#
# `.idea/` was tracked until `EKB-0216`, six files of it. IntelliJ rewrites them whenever the
# project is opened, so they turned up modified in every `git status` - and a modified tracked
# file is enough to refuse a fast-forward, which is how they got noticed.
.idea/
.vscode/
*.swp
.DS_Store

# --- generated, and regenerated by the build ---------------------------------------------------
#
# `schemagen` reflects a real database into a module of SQLAlchemy tables, the way Java's build
# points jOOQ at a Flyway'd container. The output is derived, so it is not committed - exactly
# as Java's `build/generated-jooq` is not. Each generating example repeats this in its own
# `.gitignore`; it is here too so a `git status` from the root is clean without descending.
#
# `wallet_service_sqlite/schema.py` is *not* generated - that example writes its tables by hand -
# so it is listed as an exception and stays tracked.
ekbatan-py-examples/*/schema.py
!ekbatan-py-examples/wallet_service_sqlite/schema.py

# --- the website ------------------------------------------------------------------------------
#
# `website/.gitignore` covers these too; repeated here for the same reason as above.
node_modules/
website/dist/
website/.astro/

# --- local scratch ----------------------------------------------------------------------------
*.log
# ... but a recording a test compares against is a fixture, not scratch.
!tests/fixtures/**/*.log
*.orig
*.rej
.env
.env.*
!.env.example

# The SQLite example's default url, `sqlite:///wallet.db`, is relative to wherever it is run; a
# run without WALLET_DATABASE_URL leaves the file behind.
wallet.db
